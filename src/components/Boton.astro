---
/**
 * Botón-enlace del sitio. Las acciones principales llevan la flecha
 * diagonal, como en la referencia de marca.
 */
import Flecha from "./Flecha.astro";
import { ruta } from "../lib/rutas";

interface Props {
  href: string;
  variante?: "solid" | "outline";
  flecha?: boolean;
  class?: string;
  externo?: boolean;
}

const {
  href,
  variante = "solid",
  flecha = true,
  class: className = "",
  externo = false,
} = Astro.props;
---

<a
  href={ruta(href)}
  class={`btn ${variante === "solid" ? "btn-solid" : "btn-outline"} ${className}`}
  {...externo ? { target: "_blank", rel: "noopener" } : {}}
>
  <slot />
  {flecha && <Flecha />}
</a>
