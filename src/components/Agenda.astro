---
/**
 * Sección de agenda. Si todavía no existe la página de reservas de
 * Google Calendar (site.calendarioUrl vacío), muestra la alternativa
 * honesta: WhatsApp y correo.
 */
import { site, waLink, mailtoLink } from "../data/site";
import { agenda } from "../data/inicio";
import Boton from "./Boton.astro";
---

<section id="agenda" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-16 md:py-24">
  <div class="reveal mx-auto max-w-xl text-center">
    <h2 class="text-3xl md:text-4xl">{agenda.titulo}</h2>
    <p class="mt-3 text-muted">{agenda.bajada}</p>
  </div>

  {
    site.calendarioUrl ? (
      <div class="reveal mt-8 overflow-hidden rounded-3xl border border-line bg-raised">
        <iframe
          src={site.calendarioUrl}
          title="Calendario para agendar una reunión con NODO"
          class="h-[38rem] w-full"
          loading="lazy"
        />
      </div>
    ) : (
      <div class="reveal mx-auto mt-8 flex max-w-xl flex-col items-center gap-4 rounded-3xl border border-line bg-raised p-8 text-center">
        <p class="text-muted">{agenda.fallback}</p>
        <div class="flex flex-wrap justify-center gap-3">
          <Boton href={waLink} externo>
            Escribinos por WhatsApp
          </Boton>
          <Boton href={mailtoLink} variante="outline" flecha={false}>
            {site.correo.direccion}
          </Boton>
        </div>
      </div>
    )
  }
</section>
