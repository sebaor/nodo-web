---
/**
 * La MacBook dibujada con CSS, sin imágenes. Diseño simple elegido por
 * el cliente: pantalla con bisel, muesca y base fina, sin teclado.
 * Aparece solo tres veces en el sitio: portada, servicios y (a futuro)
 * la muestra. El contenido del slot es el panel simulado, que siempre
 * es claro sin importar el modo del sitio.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div class={`laptop ${className}`}>
  <div class="laptop-screen">
    <div class="laptop-notch" aria-hidden="true"></div>
    <slot />
  </div>
  <div class="laptop-base" aria-hidden="true"></div>
</div>
